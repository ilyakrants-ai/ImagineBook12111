diff --git a/versions/1.21.11-neoforge/gradle.properties b/versions/1.21.11-neoforge/gradle.properties
new file mode 100644
index 0000000..99ad158
--- /dev/null
+++ b/versions/1.21.11-neoforge/gradle.properties
@@ -0,0 +1,11 @@
+mod.mc_dep_forgelike=[1.21.11,1.21.11]
+mod.mc_title=1.21.11
+mod.mc_targets=1.21.11
+
+deps.forge_loader=54.0.13
+deps.neoforge_loader=21.11.48
+deps.neoforge_patch=1.21+build.4
+
+deps.yarn_build=6
+
+loom.platform=neoforge
